#!/usr/bin/env python3
"""gpu-lock [--timeout S] -- <cmd...>: exclusive machine-wide GPU benchmark lock (/tmp/th-engine-gpu.lock). Wrap EVERY GPU-timed run. Builds need no lock."""
import fcntl, os, subprocess, sys, time
LOCK="/tmp/th-engine-gpu.lock"; a=sys.argv[1:]; to=7200
if a and a[0]=="--timeout": to=int(a[1]); a=a[2:]
if a and a[0]=="--": a=a[1:]
if not a: print(__doc__); sys.exit(2)
fd=os.open(LOCK, os.O_RDWR|os.O_CREAT, 0o666); t0=time.time()
while True:
    try: fcntl.flock(fd, fcntl.LOCK_EX|fcntl.LOCK_NB); break
    except BlockingIOError:
        if time.time()-t0>to: print("gpu-lock: timeout", file=sys.stderr); sys.exit(75)
        time.sleep(2)
if time.time()-t0>1: print(f"gpu-lock: acquired after {time.time()-t0:.0f}s", file=sys.stderr)
os.ftruncate(fd,0); os.write(fd, f"pid={os.getpid()} cmd={' '.join(a)}\n".encode())
try: rc=subprocess.call(a)
finally: fcntl.flock(fd, fcntl.LOCK_UN)
sys.exit(rc)
