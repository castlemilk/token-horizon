{
  "name": "token-horizon-ui",
  "version": "0.3.12",
  "description": "Token Horizon desktop AI usage, plan limits, and machine observability",
  "desktopName": "dev.token-horizon.desktop.desktop",
  "main": "./out/main/main.js",
  "license": "MIT",
  "engines": {
    "node": ">=24"
  },
  "author": {
    "name": "Token Horizon",
    "url": "https://github.com/castlemilk/token-horizon"
  },
  "scripts": {
    "dev": "npm run build:daemon && electron-vite dev -w",
    "dev:web": "vite dev -c vite.web.config.ts",
    "build:web": "vite build -c vite.web.config.ts",
    "preview:web": "vite preview -c vite.web.config.ts",
    "format": "prettier --write --list-different .",
    "format:check": "prettier --check .",
    "lint": "eslint . --ext .ts,.tsx --fix",
    "lint:check": "eslint . --ext .ts,.tsx",
    "start": "npm run build:daemon && electron-vite preview",
    "postinstall": "electron-builder install-app-deps",
    "vite:build:app": "electron-vite build",
    "build:daemon": "node scripts/build-daemon.mjs",
    "electron:build:win": "npm run build:win",
    "electron:build:mac": "npm run build:mac",
    "electron:build:linux": "npm run build:linux",
    "electron:build:dir": "npm run build:unpack",
    "build:unpack": "node scripts/package-desktop.mjs --unpacked",
    "build:win": "node scripts/package-desktop.mjs --platform win32 --arch x64",
    "build:mac": "node scripts/package-desktop.mjs --platform darwin",
    "build:linux": "node scripts/package-desktop.mjs --platform linux",
    "test:desktop": "node scripts/test-desktop.mjs",
    "smoke:desktop": "node scripts/smoke-desktop.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/castlemilk/token-horizon"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "electron",
      "esbuild"
    ]
  },
  "dependencies": {
    "@electron-toolkit/utils": "^4.0.0",
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@tanstack/react-query": "^5.101.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "electron-conveyor": "^0.4.0",
    "lucide-react": "^1.32.0",
    "radix-ui": "^1.6.7",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.4.3",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@electron-toolkit/tsconfig": "^2.0.0",
    "@eslint/js": "^9.39.5",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^5.2.0",
    "cross-env": "^10.1.0",
    "electron": "^43.4.1",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "eslint": "^9.39.5",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "jiti": "^2.7.0",
    "prettier": "^3.9.6",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.67.0",
    "vite": "^7.3.6"
  }
}
