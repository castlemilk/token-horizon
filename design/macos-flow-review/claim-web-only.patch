 /* ============================================================
    CLAIM & PUBLISH
    ============================================================ */
+function normalizedClaimHandle(value) {
+  if (typeof value !== "string") return null;
+  const handle = value.trim().replace(/^@/, "").trim();
+  return handle && handle.length <= 1000 && !/[\u0000-\u001f\u007f]/.test(handle) ? handle : null;
+}
+function claimHandleFromURL() {
+  const params = new URLSearchParams(location.search);
+  if (params.get("claim") !== "1") return null;
+  return normalizedClaimHandle(params.get("user") || state.currentHandle);
+}
